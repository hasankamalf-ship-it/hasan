<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جيم ماستر | إضافة عضو جديد</title>

    <!-- خط Readex Pro الرياضي من جوجل -->
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- مكتبة الأيقونات Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* --- المتغيرات والتصاميم الأساسية المطابقة للوحة التحكم --- */
        :root {
            --primary-gold: #ffc107;
            --primary-glow: rgba(255, 193, 7, 0.35);
            --bg-dark: #121212;
            --card-dark: #1e1e1e;
            --sidebar-dark: #161616;
            --input-bg: #181818;
            --text-main: #f0f0f0;
            --text-muted: #8e8e93;
            --border-color: #2c2c2e;
            --font-family: 'Readex Pro', sans-serif;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
        }

        /* --- القائمة الجانبية (Sidebar) --- */
        .sidebar {
            width: 260px;
            background-color: var(--sidebar-dark);
            padding: 2rem 1.2rem;
            display: flex;
            flex-direction: column;
            border-left: 1px solid var(--border-color);
            position: fixed;
            height: 100vh;
            right: 0;
            z-index: 100;
        }

        .logo {
            color: var(--primary-gold);
            font-size: 1.8rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 2.5rem;
            text-shadow: 0 0 12px var(--primary-glow);
        }

        .nav-links {
            list-style: none;
        }

        .nav-links li {
            margin-bottom: 0.6rem;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 1rem;
            display: flex;
            align-items: center;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--primary-gold);
            background-color: rgba(255, 193, 7, 0.05);
        }

        /* الزر المحدد حالياً (إضافة عضو) */
        .nav-links a.active {
            background-color: rgba(255, 193, 7, 0.12);
            color: var(--primary-gold);
            font-weight: 600;
            border: 1px solid rgba(255, 193, 7, 0.3);
            box-shadow: 0 0 10px rgba(255, 193, 7, 0.15);
        }

        .nav-links a i {
            margin-left: 12px;
            font-size: 1.2rem;
            width: 20px;
            text-align: center;
        }

        /* --- المحتوى الرئيسي (Main Content) --- */
        .main-content {
            flex: 1;
            padding: 2.5rem;
            margin-right: 260px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-title i {
            color: var(--primary-gold);
        }

        .btn-back {
            background-color: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 0.6rem 1.2rem;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back:hover {
            color: var(--text-main);
            border-color: #555;
        }

        /* --- كارت الفورم (Form Container) --- */
        .form-card {
            background-color: var(--card-dark);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            max-width: 900px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.8rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        label {
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        label i {
            color: var(--primary-gold);
            font-size: 0.85rem;
        }

        input,
        select,
        textarea {
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 0.9rem 1.2rem;
            border-radius: 10px;
            font-family: var(--font-family);
            font-size: 0.95rem;
            outline: none;
            transition: var(--transition);
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: var(--primary-gold);
            box-shadow: 0 0 12px var(--primary-glow);
        }

        select option {
            background-color: var(--card-dark);
            color: var(--text-main);
        }

        /* --- أزرار التحكم في أسفل النموذج --- */
        .form-actions {
            grid-column: span 2;
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 1rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border-color);
        }

        .btn-submit {
            background-color: var(--primary-gold);
            color: #000;
            border: none;
            padding: 0.9rem 2.5rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            box-shadow: 0 0 15px var(--primary-glow);
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background-color: #e0a800;
            box-shadow: 0 0 22px rgba(255, 193, 7, 0.6);
            transform: translateY(-2px);
        }

        .btn-cancel {
            background-color: #2a2a2c;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 0.9rem 1.8rem;
            border-radius: 10px;
            font-weight: 500;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-cancel:hover {
            background-color: #333;
            color: #fff;
        }

        /* --- استجابة الشاشات الصغيرة --- */
        @media (max-width: 992px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
                border-left: none;
                border-bottom: 1px solid var(--border-color);
                flex-direction: row;
                justify-content: space-around;
                padding: 1rem;
            }

            .main-content {
                margin-right: 0;
                padding: 1.5rem;
            }

            .logo {
                margin-bottom: 0;
                font-size: 1.4rem;
            }

            .nav-links {
                display: flex;
                gap: 0.5rem;
            }

            .nav-links a span {
                display: none;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }

            .form-actions {
                grid-column: span 1;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <!-- السايدبار الجانبي -->
    <nav class="sidebar">
        <div class="logo">جيم ماستر</div>
        <ul class="nav-links">
            <li><a href="#"><i class="fas fa-home"></i> <span>لوحة التحكم</span></a></li>
            <li><a href="/view"><i class="fas fa-users"></i> <span>الأعضاء</span></a></li>
            <!-- التحديد على زر إضافة عضو جديد -->
            <li><a href="#" class="active"><i class="fas fa-user-plus"></i> <span>إضافة عضو</span></a></li>
            <li><a href="/choich"><i class="fas fa-user-ninja"></i> <span>المدربون</span></a></li>
            <li><a href="/price"><i class="fas fa-receipt"></i> <span>الفواتير</span></a></li>
            <li><a href="/sting"><i class="fas fa-cog"></i> <span>الإعدادات</span></a></li>
        </ul>
    </nav>

    <!-- المحتوى الأساسي -->
    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">
                <i class="fas fa-user-plus"></i> إضافة عضو جديد
            </h1>
            <a href="/" class="btn-back">
                <i class="fas fa-arrow-left"></i> العودة للأعضاء
            </a>
        </header>

        <!-- نموذج الإضافة -->
        <div class="form-card">
            <form action="/" method="POST">
                <div class="form-grid">

                    <!-- الاسم الكامل -->
                    <div class="form-group">
                        <label><i class="fas fa-user"></i> الاسم الكامل</label>
                        <input name="name" type="text" placeholder="أدخل اسم العضو الثلاثي" required>
                    </div>

                    <!-- رقم الهاتف -->
                    <div class="form-group">
                        <label><i class="fas fa-phone"></i> رقم الهاتف</label>
                        <input name="tele" type="tel" placeholder="07XXXXXXXX" required>
                    </div>

                    <!-- نوع الاشتراك -->
                    <div class="form-group">
                        <label><i class="fas fa-dumbbell"></i> نوع الاشتراك</label>
                        <select name="subscription" id="subscription" required>
                            <option value="" disabled selected>اختر الباقة...</option>
                            <option value="monthly" data-days="31">اشتراك شهري 25 الف</option>
                            <option value="2 month" data-days="62">اشتراك شهرين 45 الف</option>
                            <option value="medium" data-days="185"  >اشتراك متوسط (ستة أشهر) 125 الف</option>
                            <option value="vip" data-days="400">اشتراك سنوي (سنة كاملة) 250 الف</option>
                        </select>
                    </div>

                    <!-- تاريخ البداية -->
                    <div class="form-group">
                        <label><i class="fas fa-calendar-alt"></i> تاريخ بداية الاشتراك</label>
                        <input name="datasta" id="datasta" type="date" required>
                    </div>

                    <!-- تاريخ الانتهاء -->
                    <div class="form-group">
                        <label><i class="fas fa-calendar-check"></i> تاريخ الانتهاء</label>
                        <input name="dataend" id="dataend" type="date" required>
                    </div>
                    <!-- حالة الاشتراك -->
                    <div class="form-group">
                        <label><i class="fas fa-toggle-on"></i> حالة الاشتراك</label>
                        <select name="subscri">
                            <option value="active" selected> نشط </option>
                            <option value="expired"> منتهي </option>
                            <!-- <option value="pending">قيد الانتظار</option> -->
                        </select>
                    </div>

                    <!-- العمر أو الملاحظات -->
                    <div class="form-group">
                        <label><i class="fas fa-id-card"></i> العمر</label>
                        <input name="age" type="number" placeholder="مثال: 25">
                    </div>

                    <!-- ملاحظات إضافية -->
                    <div class="form-group full-width">
                        <label><i class="fas fa-sticky-note"></i> ملاحظات خاصة (اختياري)</label>
                        <input name="notes" rows="3" placeholder="أي حالة صحية أو ملاحظات خاصة بالعضو..."></input>
                    </div>

                    <!-- الأزرار -->
                    <div class="form-actions">
                        <a href="/" class="btn-cancel">إلغاء</a>
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-check"></i> حفظ بيانات العضو
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </main>

    <script>
        const subscr = document.getElementById("subscription");
        const datasta = document.getElementById("datasta");
        const dataend = document.getElementById("dataend");
        // const alhala = document.getElementById("alhala");

        if(!datasta.value){
            datasta.value = new Date().toISOString().split("T")[0];
        }

        function updetEndDate(){
            const seletedOption = subscr.options[subscr.selectedIndex];
            const days = parseInt(seletedOption.getAttribute("data-days"));

            if(datasta.value && !isNaN(days)){
                const startDate = new Date(datasta.value);
                startDate.setDate(startDate.getDate() + days);
                dataend.value = startDate.toISOString().split("T")[0];
            }
        }

        subscr.addEventListener("change", updetEndDate);
        datasta.addEventListener("change", updetEndDate);

        updetEndDate();
    </script>

</body>

</html>