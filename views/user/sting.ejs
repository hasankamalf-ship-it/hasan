<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعدادات النظام | جيم ماستر</title>

    <!-- خط جوجل Readex Pro للعربية -->
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- مكتبة الأيقونات Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        /* --- المتغيرات الموحدة (أسود وذهبي/أصفر) --- */
        :root {
            --primary-color: #ffc107;
            /* الأصفر الذهبي */
            --primary-glow: rgba(255, 193, 7, 0.4);
            --bg-color: #121212;
            /* خلفية الموقع الداكنة */
            --card-bg: #1e1e1e;
            /* خلفية النموذج/البطاقات */
            --input-bg: #141414;
            /* خلفية حقول الإدخال */
            --sidebar-bg: #1a1a1a;
            /* خلفية القائمة الجانبية */
            --text-color: #e0e0e0;
            /* لون النص الأساسي */
            --text-muted: #a0a0a0;
            /* لون النص الثانوي */
            --border-color: #333;
            /* لون الحدود */

            --font-family: 'Readex Pro', sans-serif;
            --transition: all 0.3s ease;
        }

        /* --- الضبط العام --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* --- القائمة الجانبية (Sidebar) --- */
        .sidebar {
            width: 280px;
            background-color: var(--sidebar-bg);
            padding: 2rem 1rem;
            display: flex;
            flex-direction: column;
            border-left: 1px solid var(--border-color);
            position: fixed;
            height: 100vh;
            right: 0;
            z-index: 100;
        }

        .logo {
            color: var(--primary-color);
            font-size: 1.8rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 3rem;
            text-transform: uppercase;
            text-shadow: 0 0 10px var(--primary-glow);
        }

        .nav-links {
            list-style: none;
        }

        .nav-links li {
            margin-bottom: 0.8rem;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            padding: 0.8rem 1.2rem;
            border-radius: 12px;
            transition: var(--transition);
        }

        .nav-links a:hover,
        .nav-links a.active {
            background-color: rgba(255, 193, 7, 0.08);
            color: var(--primary-color);
            font-weight: 600;
            border: 1px solid rgba(255, 193, 7, 0.2);
            box-shadow: 0 0 10px rgba(255, 193, 7, 0.1);
        }

        .nav-links a i {
            margin-left: 15px;
            font-size: 1.3rem;
            width: 25px;
            text-align: center;
        }

        /* --- المنطقة الرئيسية (Main Content) --- */
        .main-content {
            flex: 1;
            padding: 2.5rem;
            margin-right: 280px;
            transition: var(--transition);
        }

        header {
            margin-bottom: 2rem;
        }

        header h1 {
            font-size: 2.2rem;
            font-weight: 700;
        }

        /* --- نموذج الإعدادات (Settings Form Card) --- */
        .settings-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            max-width: 900px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.8rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        .form-group label {
            color: var(--text-color);
            font-size: 0.95rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-group label i {
            color: var(--primary-color);
            font-size: 0.9rem;
        }

        .form-control {
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.85rem 1rem;
            color: var(--text-color);
            font-family: var(--font-family);
            font-size: 0.95rem;
            transition: var(--transition);
            outline: none;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(255, 193, 7, 0.2);
        }

        /* --- قسم زر الحفظ --- */
        .form-actions {
            margin-top: 2.5rem;
            display: flex;
            justify-content: flex-end;
        }

        .btn-save {
            padding: 0.9rem 2.5rem;
            border: none;
            border-radius: 12px;
            text-decoration: none !important;
            font-weight: 600;
            font-size: 1rem;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            background-color: var(--primary-color);
            color: #121212;
            box-shadow: 0 0 15px var(--primary-glow);
            font-family: var(--font-family);
        }

        .btn-save:hover {
            background-color: #e0a800;
            box-shadow: 0 0 20px rgba(255, 193, 7, 0.6);
            transform: translateY(-2px);
        }

        /* --- التجاوب مع الشاشات --- */
        @media (max-width: 1200px) {
            .sidebar {
                width: 240px;
            }

            .main-content {
                margin-right: 240px;
            }
        }

        @media (max-width: 992px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
                border-left: none;
                border-bottom: 1px solid var(--border-color);
                flex-direction: row;
                justify-content: space-around;
                padding: 1rem;
            }

            .main-content {
                margin-right: 0;
                padding: 2rem 1rem;
            }

            .logo {
                margin-bottom: 0;
                font-size: 1.5rem;
            }

            .nav-links {
                display: flex;
                gap: 0.5rem;
            }

            .nav-links li {
                margin-bottom: 0;
            }

            .nav-links a {
                padding: 0.6rem 1rem;
                font-size: 1rem;
            }

            .nav-links a span {
                display: none;
            }

            .nav-links a i {
                margin-left: 0;
                font-size: 1.4rem;
            }
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }
        }
    </style>
</head>

<body>

    <!-- القائمة الجانبية (Sidebar) -->
    <nav class="sidebar">
        <div class="logo">جيم ماستر</div>
        <ul class="nav-links">
            <li><a href="/"><i class="fas fa-th-large"></i> <span>لوحة التحكم</span></a></li>
            <li><a href="/view"><i class="fas fa-users"></i> <span>الأعضاء</span></a></li>
            <li><a href="/choich"><i class="fas fa-chalkboard-teacher"></i> <span>المدربين</span></a></li>
            <li><a href="/price"><i class="fas fa-file-invoice-dollar"></i> <span>الفواتير</span></a></li>
            <!-- قسم الإعدادات مفعل -->
            <li><a href="/sting" class="active"><i class="fas fa-cogs"></i> <span>الإعدادات</span></a></li>
        </ul>
    </nav>

    <!-- المحتوى الرئيسي (Main Content) -->
    <main class="main-content">
        <header>
            <h1>إعدادات النظام (Platform Settings)</h1>
        </header>
        <!-- كارت نموذج الإعدادات - مطابقة لحقول الصورة -->
        <section class="settings-card">
            <form action="#" method="POST">
                <div class="form-grid">

                    <!-- اسم المنصة / الجيم -->
                    <div class="form-group full-width">
                        <label><i class="fas fa-building"></i> اسم المنصة (Platform Name)</label>
                        <input type="text" class="form-control" value="Gym SaaS Platform">
                    </div>

                    <!-- بريد المنصة -->
                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> البريد الإلكتروني للمنصة (Platform Email)</label>
                        <input type="email" class="form-control" value="admin@gymsaas.com">
                    </div>

                    <!-- بريد الدعم -->
                    <div class="form-group">
                        <label><i class="fas fa-headset"></i> بريد الدعم الفني (Support Email)</label>
                        <input type="email" class="form-control" value="support@gymsaas.com">
                    </div>

                    <!-- فترة التجربة الافتراضية -->
                    <div class="form-group">
                        <label><i class="fas fa-calendar-alt"></i> أيام التجربة الافتراضية (Default Trial Days)</label>
                        <input type="number" class="form-control" value="14">
                    </div>

                    <!-- العملة -->
                    <div class="form-group">
                        <label><i class="fas fa-money-bill-wave"></i> العملة (Currency)</label>
                        <input type="text" class="form-control" value="USD ($)">
                    </div>

                    <!-- نسبة الضريبة -->
                    <div class="form-group">
                        <label><i class="fas fa-percent"></i> نسبة الضريبة (Tax Rate %)</label>
                        <input type="number" class="form-control" value="0">
                    </div>

                    <!-- رابط الشروط والأحكام -->
                    <div class="form-group">
                        <label><i class="fas fa-file-contract"></i> رابط الشروط (Terms URL)</label>
                        <input type="url" class="form-control" placeholder="https://example.com/terms">
                    </div>

                    <!-- رابط سياسة الخصوصية -->
                    <div class="form-group full-width">
                        <label><i class="fas fa-user-shield"></i> رابط سياسة الخصوصية (Privacy URL)</label>
                        <input type="url" class="form-control" placeholder="https://example.com/privacy">
                    </div>

                </div>

                <!-- زر حفظ الإعدادات -->
                <div class="form-actions">
                        <a href="/" class="btn-save"><i class="fas fa-save"></i> حفظ الإعدادات </a>
                </div>
            </form>
        </section>
    </main>

</body>

</html>